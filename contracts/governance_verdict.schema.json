{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-shield/contracts/governance_verdict.schema.json",
  "title": "GovernanceVerdict",
  "x-status": "W0-STUB — frozen at W1 as shield_version 1.1 by sdk-builder (C11/ADR-0007). The three cost fields (reasons[].model_id, reasons[].served_via, obligations.prevented_loss) are part of the v1.1 baseline from W1, NOT a later additive.",
  "x-shield-version": "1.1",
  "type": "object",
  "required": ["shield_version", "decision", "correlation_id"],
  "properties": {
    "shield_version": { "type": "string", "const": "1.1" },
    "decision": {
      "type": "string",
      "enum": ["PASS", "ALERT", "BLOCK", "ESCALATE", "ROLLBACK", "REWRITE"]
    },
    "correlation_id": { "type": "string" },
    "risk_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "guardian": { "type": "string", "enum": ["defender", "evaluator", "supervisor", "auditor"] },
          "model_id": { "type": ["string", "null"], "description": "v1.1 cost field" },
          "served_via": { "type": ["string", "null"], "enum": ["cloud", "local", null], "description": "v1.1 cost field" }
        },
        "required": ["code"]
      }
    },
    "obligations": {
      "type": "object",
      "properties": {
        "rewrite_args": { "type": ["object", "null"] },
        "mask_args": { "type": ["array", "null"], "items": { "type": "string" } },
        "require_human": { "type": ["boolean", "null"] },
        "rollback": {
          "type": ["object", "null"],
          "properties": {
            "langgraph_checkpoint_id": { "type": ["string", "null"] },
            "env_snapshot_ref": { "type": ["string", "null"] }
          }
        },
        "prevented_loss": { "type": ["number", "null"], "description": "v1.1 cost field — $ value of prevented action" }
      }
    },
    "latency_ms": { "type": ["number", "null"] }
  },
  "additionalProperties": true
}
