# Agent Shield — example environment. COMMITTED (the real `.env` / `.env.*` is
# gitignored; `!.env.example` is the single tracked exception, cicd.md §6).
# Copy to `.env` and adjust. Defaults match infra/docker-compose.yml.

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=shield
POSTGRES_PASSWORD=shield
POSTGRES_DB=shield
DATABASE_URL=postgresql://shield:shield@localhost:5432/shield

# --- Redis (Channel-2 streams) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- MinIO (object store) ---
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=shield
MINIO_ROOT_PASSWORD=shieldsecret
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false

# --- ChromaDB (governance memory) ---
CHROMA_HOST=localhost
CHROMA_PORT=8000

# --- Eval / LLM backend ---
# PR CI uses the mock backend so NO API keys live in PR CI (cicd.md §3).
SHIELD_LLM_BACKEND=mock
# Real-model eval only (release/eval workflow, protected `eval` environment).
# Leave EMPTY here; never commit a real key.
ANTHROPIC_API_KEY=

# ─── Enterprise Auth v1 (ADR-0013) ────────────────────────────────────────
# Mode: open (CI/dev default, requires --allow-open-auth CLI flag in prod) | enterprise | api_token_only
SHIELD_AUTH_MODE=open
# Session signing keys (list, comma-separated kid:base64url(32B); first = active)
SHIELD_SESSION_SECRETS=k1:DEV_REPLACE_ME_BASE64URL_32B
# Password pepper (list, same shape; first = active, lazy re-hash at login)
SHIELD_PASSWORD_PEPPERS=p1:DEV_REPLACE_ME_BASE64URL_32B
# TOTP secret encryption at rest (MultiFernet list, kid:base64url(32B))
SHIELD_AUTH_FERNET_KEYS=f1:DEV_REPLACE_ME_BASE64URL_32B
# argon2id params (env-tunable WITH HARDCODED CAPS per ADR-0013 §A1; refuse-to-start if over)
# Defaults: m=65536 t=3 p=4 ; Caps (NOT env-tunable): m≤262144 t≤8 p≤8
# SHIELD_ARGON2_MEMORY_COST_KIB=65536
# SHIELD_ARGON2_TIME_COST=3
# SHIELD_ARGON2_PARALLELISM=4
# Email transport: console (dev/demo only, REFUSED in enterprise mode per §A4) | file (test mailbox) | smtp (prod)
SHIELD_EMAIL_BACKEND=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Agent Shield <noreply@agent-shield.local>
SMTP_STARTTLS=false
# WARNING: NEVER commit real secrets here; use a secrets manager in production.
