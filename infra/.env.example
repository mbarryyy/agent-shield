# Agent Shield — example environment. COMMITTED (the real `.env` / `.env.*` is
# gitignored; `!.env.example` is the single tracked exception, cicd.md §6).
# Copy to `.env` and adjust. Defaults match infra/docker-compose.yml.

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=shield
POSTGRES_PASSWORD=shield
POSTGRES_DB=shield
DATABASE_URL=postgresql://shield:shield@localhost:5432/shield

# --- Redis (Channel-2 streams) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- MinIO (object store) ---
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=shield
MINIO_ROOT_PASSWORD=shieldsecret
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false

# --- ChromaDB (governance memory) ---
CHROMA_HOST=localhost
CHROMA_PORT=8000

# --- Eval / LLM backend ---
# PR CI uses the mock backend so NO API keys live in PR CI (cicd.md §3).
SHIELD_LLM_BACKEND=mock
# Real-model eval only (release/eval workflow, protected `eval` environment).
# Leave EMPTY here; never commit a real key.
ANTHROPIC_API_KEY=
